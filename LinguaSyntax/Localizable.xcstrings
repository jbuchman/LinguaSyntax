    "Count parts of speech in text and export the result as text or styled RTF.": {
      "comment": "Intent description for the \"Export Parts of Speech\" intent.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuente partes del discurso en texto y exporte el resultado como texto o RTF con estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez les parties de la parole dans le texte et exportez le résultat sous forme de texte ou de style RTF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählen Sie Teile der Sprache im Text und exportieren Sie das Ergebnis als Text oder RTF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contare parti del discorso nel testo ed esportare il risultato come testo o RTF in stile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte partes do discurso no texto e exporte o resultado como texto ou RTF estilizado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel delen van spraak in tekst en exporteer het resultaat als tekst of gestileerde RTF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Policz części mowy w tekście i wyeksportuj wynik jako tekst lub w stylu RTF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсчитайте части речи в тексте и экспортируйте результат в виде текста или в стиле RTF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підраховуйте частини мови в тексті та експортуйте результат у вигляді тексту або стилізованого RTF."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metindeki konuşma bölümlerini sayın ve sonucu metin veya tarz RTF olarak dışa aktarın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト内の音声部分をカウントし、結果をテキストまたはスタイルRTFとしてエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트에서 말의 일부를 계산하고 결과를 텍스트 또는 스타일 RTF로 내보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算文本中的语音部分，并将结果导出为文本或RTF样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算文字中的語音部分，並將結果匯出為文字或RTF樣式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد أجزاء الكلام في النص وقم بتصدير النتيجة كنص أو على غرار RTF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट में स्पीच के कुछ हिस्सों की गणना करें और परिणाम को टेक्स्ट या स्टाइल किए गए RTF के रूप में निर्यात करें।"
          }
        }
