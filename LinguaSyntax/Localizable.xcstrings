    "Use %@ as the starting point for a new custom theme.": {
      "comment": "A message that appears in an alert when the user has not selected a custom theme.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice %@ como punto de partida para un nuevo tema personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez %@ comme point de départ pour un nouveau thème personnalisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie %@ als Ausgangspunkt für ein neues benutzerdefiniertes Design."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza %@ come punto di partenza per un nuovo tema personalizzato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@ como ponto de partida para um novo tema personalizado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik %@ als uitgangspunt voor een nieuw aangepast thema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj %@ jako punktu wyjścia dla nowego niestandardowego motywu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте %@ в качестве отправной точки для новой пользовательской темы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте %@ як відправну точку для нової користувацької теми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir özel tema için başlangıç noktası olarak %@ kullanın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいカスタムテーマの出発点として%@を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 새로운 사용자 정의 테마의 시작점으로 사용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%@作为新自定义主题的起点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%@作為新自訂佈景主題的起點。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم %@ كنقطة انطلاق لقالب مخصص جديد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नए कस्टम थीम के लिए शुरुआती बिंदु के रूप में %@ का उपयोग करें।"
